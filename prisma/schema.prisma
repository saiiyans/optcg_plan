// Schéma de la base de données (PostgreSQL, hébergée sur Neon)
// Couvre les tables Cards, CardPrints, Sets, PersonalRatings, Decks,
// DeckCards, ImportLogs, LegalityUpdates, TournamentDecks, Match, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Une "Card" = une carte de gameplay unique (un numéro officiel : OP14-033, ST32-003...).
// Les illustrations alternatives (aa, fa, prize card...) ne créent PAS de nouvelle Card :
// elles sont regroupées comme des CardPrints de la même Card.
model Card {
  id             String   @id @default(cuid())
  cardNumber     String   @unique // ex: OP14-033
  name           String
  category       String   // Character | Event | Stage
  color          String   // Green (peut contenir plusieurs couleurs pour multicolore)
  setCode        String   // ex: OP14, EB01, ST32
  rarity         String?
  cost           Int?
  power          Int?
  life           Int?     // uniquement pour les Leaders — jamais stocké avant cette carte
  counter        Int?     // valeur numérique du Counter (0 si absent)
  attribute      String?  // Slash / Strike / Wisdom / Special / Ranged
  // Statut "leak" — générique, pas propre à OP17, pour que tout futur set en
  // période de reveal (OP18, etc.) puisse réutiliser le même champ sans
  // migration supplémentaire.
  isLeak         Boolean  @default(false)
  types          String   // ex: "Supernovas/Beautiful Pirates" (types & affiliations bruts)
  officialText   String?  // texte d'effet officiel complet (anglais, tel que scrapé)
  officialTextFr String?  // traduction française du texte officiel — ne remplace jamais officialText
  triggerText    String?
  imageUrl       String   // URL distante officielle (pas de copie locale par défaut)
  localImagePath String?  // renseigné uniquement si la mise en cache locale est explicitement autorisée
  cardUrl        String   // URL de la fiche Limitless
  sourceUrl      String   // URL de la requête/source ayant permis l'import
  releaseDate    String?
  legalityStatus String?  // ex: "Standard: legal / Extra: legal"
  block          String?  // ex: "Block 4"
  language       String   @default("en")
  importedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Champs verrouillés dès qu'une correction manuelle est faite, pour ne
  // jamais l'écraser silencieusement lors d'une resynchronisation.
  manuallyEditedFields String? // liste JSON des noms de champs corrigés à la main

  // --- Contenu "Coach" ---
  // Historiquement pensé pour être rédigé à la main ; génération en masse
  // via l'API Anthropic explicitement autorisée depuis cette mise à jour,
  // pour couvrir l'ensemble des couleurs importées. coachReviewed=true dès que
  // du contenu (manuel OU généré) existe ; false = l'app affiche un
  // message clair plutôt que d'inventer du contenu à la volée.
  coachReviewed        Boolean  @default(false)
  coachExplanationEn   String?
  coachExplanationFr   String?
  mihawkAnalysisFr     String?
  mihawkPros           String? // JSON string[]
  mihawkCons           String? // JSON string[]
  mihawkSynergies      String? // JSON string[] de cardNumber
  mihawkCommonUse      String?
  mihawkCommonMistake  String?
  // Pour les cartes non-vertes (non jouables par Mihawk) : impact de cette
  // carte quand elle apparaît dans le deck adverse, en français.
  opponentMatchupNote  String?

  prints         CardPrint[]
  ratings        PersonalRating[]
  deckCards      DeckCard[]

  @@index([color])
  @@index([setCode])
  @@index([category])
  @@index([isLeak])
}

// Cartes leak/reveal dont l'ID numérique définitif OU une donnée requise
// (couleur, etc.) n'est pas encore assez fiable pour rejoindre la table
// Card canonique — jamais mélangées aux vraies cartes, jamais affichées
// dans les filtres normaux. Un ID temporaire (temp_id) sert de clé, jamais
// un OP17-NNN inventé.
model PendingLeakCard {
  id        String   @id @default(cuid())
  tempId    String   @unique // ex: "OP17-JACK", "OP17-KING"
  name      String
  setCode   String   // ex: OP17
  cardType  String?  // Leader | Character | Event | Stage — si connu
  color     String?  // souvent inconnu, jamais deviné
  reason    String   // pourquoi cette carte n'est pas encore canonique
  createdAt DateTime @default(now())

  @@index([setCode])
}

// Une "CardPrint" = une illustration/édition précise de la carte (aa, fa, prize card, réimpression...).
model CardPrint {
  id           String   @id @default(cuid())
  cardId       String
  card         Card     @relation(fields: [cardId], references: [id])
  printLabel   String   // ex: "Alternate Art", "Prize Card", "Reprint PRB02"
  imageUrl     String
  setCode      String
  variantIndex Int      @default(0) // correspond au paramètre ?v= de Limitless
  importedAt   DateTime @default(now())

  @@index([cardId])
}

model Set {
  id          String   @id @default(cuid())
  setCode     String   @unique // ex: OP14, EB01
  name        String
  block       String?
  releaseDate String?
  cardCount   Int?
  importedAt  DateTime @default(now())
}

// Notation personnelle "compatibilité Mihawk" (0 à 5 étoiles) + note personnelle libre.
model PersonalRating {
  id               String   @id @default(cuid())
  cardId           String
  card             Card     @relation(fields: [cardId], references: [id])
  leaderContext    String   @default("Mihawk OP14-020") // pour permettre d'autres leaders plus tard (ex: Shanks OP17)
  stars            Float    // 0 à 5, par pas de 0.5 — calculé automatiquement puis modifiable à la main
  autoStars        Float    // valeur calculée par le moteur de notation, jamais écrasée par l'édition manuelle
  justification    String   // explication de la note, éditable
  confidence       String   // "élevé" | "moyen" | "données insuffisantes"
  recommendedCount Int?     // quantité recommandée (0 à 4)
  personalNotes    String?
  isManualOverride Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  @@unique([cardId, leaderContext])
}

model Deck {
  id        String     @id @default(cuid())
  name      String
  leaderCardNumber String // ex: OP14-020
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cards     DeckCard[]
  versions  DeckVersion[]
  matches   Match[] // parties d'entraînement officielles liées à ce deck (section 16)
}

// --- Versions de deck (Lot 3, Priorité 7B) — à chaque mise à jour de la
// liste d'un deck personnel, la liste PRÉCÉDENTE est automatiquement
// archivée ici avant d'être remplacée. Aucune liste n'est donc jamais
// perdue silencieusement, même en cas de "mise à jour" plutôt que
// "nouvelle version" explicite.
model DeckVersion {
  id            String   @id @default(cuid())
  deckId        String
  deck          Deck     @relation(fields: [deckId], references: [id])
  listJson      String   // JSON [{cardNumber, quantity}] — snapshot exact au moment de l'archivage
  personalNote  String?
  changeReason  String?
  versionNumber Int?     // numéro de version archivée (nombre de versions précédant celle-ci + 1) ;
                         // null pour les versions archivées avant l'introduction de ce champ —
                         // jamais recalculé rétroactivement pour ne pas fabriquer une donnée incertaine
  createdAt     DateTime @default(now())

  @@index([deckId])
}

model DeckCard {
  id       String @id @default(cuid())
  deckId   String
  deck     Deck   @relation(fields: [deckId], references: [id])
  cardId   String
  card     Card   @relation(fields: [cardId], references: [id])
  quantity Int    @default(1) // maximum 4, contrôlé côté application
  status   String @default("in_deck") // in_deck | favorite | owned | shopping_list | testing

  @@unique([deckId, cardId, status])
}

// Journal de chaque exécution de l'importateur : ce qui a réussi, ce qui a échoué.
model ImportLog {
  id            String   @id @default(cuid())
  runType       String   // "preview" | "test_5" | "full_import" | "sync"
  sourceUrl     String
  cardsFound    Int
  cardsImported Int
  cardsUpdated  Int
  cardsSkipped  Int
  errors        String?  // JSON des erreurs rencontrées
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
}

// Historique des changements de légalité (bannissements, rotations de blocs...).
model LegalityUpdate {
  id         String   @id @default(cuid())
  cardNumber String
  format     String   // "Standard" | "Extra"
  oldStatus  String?
  newStatus  String
  effectiveDate String?
  sourceUrl  String?
  recordedAt DateTime @default(now())
}

// Une decklist de tournoi récupérée sur onepiecetopdecks.com (catégorie "OP16 Winning Decks").
// Filtre strict à l'import : deckProfile = "op14mihawk" ET leaderCardNumber = "OP14-020".
model TournamentDeck {
  id               String   @id @default(cuid())
  uniqueKey        String   @unique // leader+player+date+tournament+host+placement, pour dédupliquer sans jamais écraser un ancien résultat par erreur
  leaderCardNumber String   // OP14-020
  deckProfile      String   // op14mihawk
  deckColor        String   // Green
  deckName         String   // "G Mihawk"
  format           String   @default("OP16")
  player           String
  country          String
  date             String   // tel qu'affiché sur la source, ex "8/2/2026"
  placementRaw     String   // ex: "1st (8-1)", "T4 (4-1)", "2nd Place"
  wins             Int?
  losses           Int?
  undefeated       Boolean  @default(false)
  status           String   // "winner" | "top_performer" | "unverified"
  proofLevel       String?  // "gold" (1st) | "silver" (top4/top8) | "bronze" (résultat positif sans top4)
  tournamentType   String   // ex: FS, SB, 3v3, EXGrand, Area Qualifiers
  host             String
  participants     Int?     // extrait de hs=Nom(58) si présent
  cardCountNonLeader Int    // nombre de cartes hors Leader détecté par le parseur
  validationStatus String   // "valid" (exactement 50) | "needs_review"
  rawDecklist      String   // chaîne compacte brute d'origine, jamais modifiée
  sourceUrl        String
  importedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt
  savedToMyDecks   Boolean  @default(false) // ajouté par l'utilisateur à sa rubrique "Mes Decks"

  cards TournamentDeckCard[]
  inspiredMatches Match[]

  @@index([deckProfile])
  @@index([status])
  @@index([date])
}

model TournamentDeckCard {
  id             String         @id @default(cuid())
  tournamentDeckId String
  tournamentDeck TournamentDeck @relation(fields: [tournamentDeckId], references: [id])
  cardNumber     String         // numéro brut ; peut ne pas exister encore dans Card si carte non-verte (ex: leader)
  quantity       Int

  @@index([tournamentDeckId])
  @@index([cardNumber])
}

// --- Préparation tournoi (fusion de l'ancien planning/journal HTML) ---

// Une partie jouée en simulateur ou en boutique, notée pour suivre les matchups.
model Match {
  id             String   @id @default(cuid())
  date           String   // ISO (yyyy-mm-dd)
  mode           String   // "Simulateur" | "Boutique"
  myDeck         String   // "Mihawk OP14-020" | "Shanks OP17"
  opponentLeader String
  result         String   // "Victoire" | "Défaite"
  cardsToWatch   String?
  notes          String?
  createdAt      DateTime @default(now())
  // Clé de déduplication pour l'import automatique depuis Card D. Kaizoku —
  // construite à partir de date+heure+adversaire+résultat, null pour toute
  // partie saisie manuellement. Le champ étant @unique, une seconde
  // tentative d'import du même match échoue simplement au lieu de dupliquer.
  kaizokuId      String?  @unique

  // --- Saisie rapide (Phase 1 coaching) — tous optionnels pour ne rien
  // casser sur les parties déjà enregistrées (manuelles ou importées de
  // Kaizoku, qui ne renseignent aucun de ces champs). ---
  turnOrder      String?  // "Premier" | "Second"
  mulligan       Boolean?
  openingHandQuality String? // "Bonne" | "Correcte" | "Mauvaise"
  mainMistake    String?  // une des erreurs rapides prédéfinies, voir coachDiagnostic.ts — conservée pour compatibilité, contient la 1ère case cochée
  mistakesJson   String?  // JSON string[] — toutes les erreurs cochées (sélection multiple), mainMistake n'en garde qu'une seule pour les anciennes stats
  mostUsefulCard String?  // numéro de carte, en texte libre — ne référence jamais Card en relation stricte
  uselessCard    String?
  keyTurn        String?  // ex. "Tour 4"

  // --- Normalisation du leader adverse (Lot 2) — opponentLeader (texte
  // brut saisi) n'est JAMAIS modifié ni supprimé, sert toujours d'affichage
  // de secours. opponentLeaderId est renseigné automatiquement quand une
  // correspondance fiable est trouvée/créée, pour regrouper les stats sans
  // perdre le texte original saisi. ---
  opponentLeaderId String?
  opponentLeaderRef OpponentLeader? @relation(fields: [opponentLeaderId], references: [id])

  // --- Analyse détaillée (Lot 2) — tous optionnels, jamais rétroactifs sur
  // les parties déjà enregistrées. ---
  confidence            Int?     // 1 à 5, confiance dans ses décisions
  donRecoveredUnused    Int?     // DON!! récupérés (effet Leader) mais non utilisés
  cardsInHandEnd        Int?
  opponentLifeRemaining Int?
  gameDurationMinutes   Int?
  mihawkActivations     Int?     // nombre d'activations de l'effet Leader Mihawk
  mihawkEffectForgotten Boolean?
  mihawkEffectTooEarly  Boolean?
  firstCost5Turn        Int?     // tour du premier personnage coût 5+
  decisiveMoment        String?  // menace adverse déterminante / moment clé, texte libre

  // Deck gagnant sauvegardé dont cette partie s'inspire/teste des idées —
  // facultatif, jamais requis. Permet de voir si un deck gagnant qui a
  // influencé tes choix fonctionne bien pour toi une fois testé.
  inspiredByDeckId String?
  inspiredByDeck   TournamentDeck? @relation(fields: [inspiredByDeckId], references: [id])

  insights CoachInsight[]

  // --- Journal coaching avancé — tous facultatifs, ajoutés rétroactivement :
  // aucune partie déjà enregistrée n'est affectée (elles gardent simplement
  // ces champs à null). Voir src/lib/defeatAnalysis.ts pour la logique qui
  // les exploite. ---

  // "Ma raison initiale" — texte libre écrit par le joueur juste après la
  // partie. Ce champ n'est JAMAIS rempli ni modifié par l'analyse du coach :
  // seul le joueur peut l'écrire ou le corriger, via PATCH /api/matches/:id.
  // Affiché séparément de "Analyse du coach", toujours dans son propre bloc.
  lossReason        String?
  // "Ce que j'aurais pu faire autrement" — propre réflexion du joueur,
  // distincte de la ligne de jeu suggérée par le coach.
  whatCouldHaveDoneDifferently String?
  openingHandKeyCards   String? // "Cartes importantes dans ma main de départ"
  boardStateAtCritical  String? // "État du board au moment critique"
  myLifeRemaining       Int?    // "Nombre de Life restantes" (les miennes)

  // --- Phase d'entraînement — sépare la phase de test/apprentissage du
  // vrai entraînement compétitif. Le défaut Prisma ("test") ne sert QUE
  // pour le backfill de `db push` sur les parties déjà existantes : toute
  // nouvelle partie passe explicitement "official_training" côté API
  // (src/app/api/matches/route.ts), jamais via ce défaut. Voir
  // src/lib/trainingPhase.ts. ---
  trainingPhase String @default("test") // "test" | "official_training"

  // --- Qualité de la décision vs lecture du résultat (séparés : une
  // victoire n'est pas automatiquement une bonne partie, une défaite pas
  // automatiquement une mauvaise). Tous facultatifs. ---
  decisionQuality String? // "Très bonne" | "Correcte" | "Plusieurs erreurs" | "Erreur décisive" | "Je ne sais pas"
  resultReading   String? // "Victoire logique" | "Défaite logique" | "Victoire malgré une erreur" | "Défaite malgré de bonnes décisions" | "Variance importante" | "Je ne sais pas"

  // --- Version du deck utilisée (facultatif) — lien vers Deck (Mes
  // Decks). deckVersionNumber et deckNameAtLog sont des instantanés pris
  // au moment de l'enregistrement (nombre de DeckVersion archivées + 1,
  // et nom du deck à cet instant) : ils ne changent JAMAIS rétroactivement
  // si le deck est ensuite renommé ou modifié, pour que les statistiques
  // par version restent stables dans le temps. ---
  deckId            String?
  deckRef           Deck?   @relation(fields: [deckId], references: [id])
  deckVersionNumber Int?
  deckNameAtLog     String?

  // --- Suppression douce (section 18) — permet une confirmation avant
  // suppression ET un "annuler" immédiat juste après : DELETE ne fait que
  // poser cette date, rien n'est jamais réellement effacé depuis l'app.
  // GET /api/matches exclut ces lignes par défaut. ---
  deletedAt DateTime?

  @@index([myDeck])
  @@index([opponentLeader])
  @@index([opponentLeaderId])
  @@index([trainingPhase])
  @@index([deckId])
  @@index([deletedAt])
}

// --- Paramètres globaux de l'application — une seule ligne (id fixe
// "singleton"), créée à la demande. Sert notamment la date de début de
// l'entraînement officiel, modifiable dans les paramètres (section 1). ---
model AppSettings {
  id                         String   @id @default("singleton")
  officialTrainingStartDate String? // ISO yyyy-mm-dd
  // --- Source unique de configuration (refonte "espace de préparation
  // tournoi") — date du tournoi actif et deck actif, modifiables depuis les
  // Paramètres plutôt que codés en dur dans chaque page. Repli sur les
  // constantes DEFAULT_TOURNAMENT_DATE / DEFAULT_DECK_NAME de src/lib/config.ts
  // tant qu'aucune valeur n'est réglée ici (voir getActiveConfig() dans
  // src/lib/appConfig.ts — TOUJOURS passer par cette fonction, jamais
  // relire ces deux champs directement ailleurs dans l'app).
  activeTournamentDate       String? // ISO yyyy-mm-dd
  activeDeckName             String? // ex: "Mihawk OP14-020" — texte libre, cohérent avec Match.myDeck
  updatedAt                  DateTime @updatedAt
}

// --- Instantané de la grille de matchups de la méta actuelle (leader vs
// leader), récupérée sur demande depuis une source publique externe
// (opdecks.xyz/winmatrix — voir src/lib/metaMatchupScraper.ts). Différent
// des statistiques de matchup personnelles (issues des propres parties du
// joueur, table Match) : ceci reflète la méta communautaire globale.
// Une seule ligne (id fixe "singleton") — jamais de récupération
// automatique en arrière-plan, uniquement via le bouton "Actualiser".
model MetaMatchupSnapshot {
  id        String   @id @default("singleton")
  dataJson  String // MetaMatchupData sérialisé (leaders + matrice de %)
  sourceUrl String
  fetchedAt DateTime @updatedAt
}

// --- Mission d'entraînement active (section 10) — une seule mission
// "active" à la fois par construction applicative (jamais dix erreurs à
// corriger en même temps). Une nouvelle partie liée à cette mission
// ajoute son id à matchIdsJson ; au bout de 3, la mission passe à
// "completed" ou "abandoned" selon le choix du joueur (continuer /
// valider / passer à la priorité suivante). Voir src/lib/missionEngine.ts.
model TrainingMission {
  id           String    @id @default(cuid())
  priorityKey  String    // une des 10 priorités de TRAINING_PRIORITIES (defeatAnalysis.ts)
  status       String    @default("active") // "active" | "completed" | "abandoned"
  why          String?   // pourquoi cette mission a été sélectionnée
  matchIdsJson String    @default("[]") // JSON string[] — ids des parties comptées vers cette mission (max 3)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  outcome      String?   // bilan à la clôture (amélioration observée ou non), jamais fabriqué

  @@index([status])
}

// --- Normalisation des leaders adverses (Lot 2) — regroupe les variantes
// d'un même leader ("Luffy Noir OP17", "Luffy Noir (OP17)", "Monkey D.
// Luffy Noir") sous un même identifiant, sans jamais supprimer ni modifier
// le texte brut saisi dans Match.opponentLeader. Fusion manuelle possible
// via l'API, jamais automatique au-delà d'une normalisation légère
// (casse/ponctuation) pour éviter de fusionner deux leaders réellement
// différents par erreur.
model OpponentLeader {
  id          String   @id @default(cuid())
  displayName String   // nom canonique affiché
  rawNames    String   // JSON string[] — toutes les variantes brutes déjà vues
  color       String?
  setCode     String?
  // Identifiant canonique basé sur le numéro de carte (section 11), ex.
  // "OP17-039" pour Rocks D. Xebec — facultatif : renseigné à la main via
  // l'outil de fusion/normalisation, jamais deviné automatiquement.
  cardNumber  String?
  createdAt   DateTime @default(now())
  matches     Match[]

  @@index([cardNumber])
}

// --- Coaching (Phase 1) — table séparée, référence Match par id, ne touche
// jamais à Card ni à son schéma. Une ligne = le diagnostic généré après une
// partie (leçon + erreur prioritaire + conseil + exercice), OU le
// diagnostic "mission du jour" (matchId = null dans ce cas).
model CoachInsight {
  id          String   @id @default(cuid())
  matchId     String?
  match       Match?   @relation(fields: [matchId], references: [id])
  kind        String   // "post_match" | "daily_mission" | "post_match_defeat"
  lesson      String?
  priorityError String?
  advice      String?
  exercise    String?
  createdAt   DateTime @default(now())

  // --- Analyse du coach (Journal, kind="post_match_defeat") — étend le
  // modèle sans toucher aux 4 champs déjà présents. Chaque régénération
  // (bouton "Régénérer l'analyse") crée une NOUVELLE ligne, jamais un
  // update en place : l'historique des analyses précédentes d'une même
  // partie reste consultable, et Match.lossReason n'est jamais touché par
  // ce mécanisme (voir src/lib/defeatAnalysis.ts). ---
  mainCause            String?  // "Cause principale" — une phrase
  secondaryCauses      String?  // JSON string[] — jusqu'à 3 raisons secondaires
  criticalMoment       String?  // "Moment critique"
  technicalTerm        String?  // clé du terme technique principal (voir TECHNICAL_TERMS)
  bestLine             String?  // "Meilleure ligne possible"
  bestLineIsHypothesis Boolean  @default(true) // true si présentée comme hypothèse faute de données
  lessonFr             String?  // "Leçon à retenir" (distinct de `lesson`, conservé pour compat)
  exerciseNext         String?  // "Exercice pour la prochaine partie" (distinct de `exercise`)
  confidenceLevel      String?  // "Élevé" | "Moyen" | "Faible"
  missingInfoQuestions String?  // JSON string[] — 1 à 3 questions
  classification       String?  // cause principale de classification (voir section 6 du cahier des charges)
  classificationSecondary String? // JSON string[] — max 2 causes secondaires
  fundamentalsFlagged  String?  // JSON string[] — sous-ensemble des 6 fondamentaux soutenus par les données

  @@index([matchId])
  @@index([kind])
}

// Un item de la checklist Objectifs (méta / cartes / stratégies / matchups).
// Les items par défaut sont semés une seule fois ; l'utilisateur peut en
// ajouter d'autres (isDefault=false) et cocher/décocher n'importe lequel.
model ObjectiveItem {
  id        String  @id @default(cuid())
  category  String  // "meta" | "cartes" | "strat" | "matchups"
  text      String
  isDefault Boolean @default(true)
  done      Boolean @default(false)
  order     Int     @default(0)

  @@index([category])
}

// Bloc libre "5 infos importantes" par semaine du planning (semaine 1 à 7).
model WeeklyInfo {
  weekNumber Int      @id
  content    String   @default("")
  updatedAt  DateTime @updatedAt
}

// --- Tier List des leaders de la méta (nouvelle rubrique) ---
// Chaque leader adverse (identifié par son numéro de carte) a un tier
// (S/A/B/C/D) — modifiable à la main, ou rempli en masse par le bouton
// "Classer automatiquement" qui applique un instantané basé sur les
// decklists soumises sur onepiecetopdecks.com. tierSource distingue les
// deux origines pour ne jamais confondre un classement manuel avec un
// classement automatique dans l'affichage.
model LeaderTierEntry {
  id          String   @id @default(cuid())
  cardNumber  String   @unique // ex: OP15-058
  displayName String   // ex: "Enel"
  color       String?
  tier        String   // "S" | "A" | "B" | "C" | "D"
  tierSource  String   @default("manual") // "manual" | "auto"
  note        String?
  order       Int      @default(0) // position exacte dans le tier, glisser-déposer
  updatedAt   DateTime @updatedAt

  @@index([tier])
}

// --- Key Cards (nouvelle rubrique) — quelles cartes vertes sont clés à
// jouer contre chaque leader de la méta. Relation plusieurs-à-plusieurs :
// une carte peut être clé contre plusieurs leaders, un leader peut avoir
// plusieurs cartes clés. Jamais de doublon exact grâce à @@unique.
model KeyCardEntry {
  id               String   @id @default(cuid())
  cardNumber       String   // la carte verte désignée comme clé
  leaderCardNumber String   // le leader adverse concerné
  note             String?
  createdAt        DateTime @default(now())

  @@unique([cardNumber, leaderCardNumber])
  @@index([leaderCardNumber])
  @@index([cardNumber])
}

// --- Rubrique "Apprentissage" (nouvelle rubrique, demandée le 30/08/2026) —
// articles de stratégie/fondamentaux OPTCG, récupérés EN DIRECT depuis
// plusieurs sites (voir src/lib/learnScraper.ts) à chaque clic sur
// "Actualiser", jamais un contenu écrit à la main ici. isPillar marque les 4
// articles fondamentaux explicitement désignés par le joueur comme base de
// la méthodologie du coach (2K Rule, économie du DON!!, erreurs de
// débutant/défense, glossaire des rôles de matchup) : toujours affichés en
// premier, jamais supprimés même si une récupération suivante ne les
// retrouve pas (source="opdecks" protégée, voir refresh/route.ts).
model LearnArticle {
  id              String    @id @default(cuid())
  url             String    @unique
  source          String    // "opdecks" | "tcgprotectors" | "shonentcg"
  sourceLabel     String    // libellé humain affiché (nom du site + ce qu'il couvre)
  title           String
  summary         String?
  durationMinutes Int?
  publishedAt     DateTime?
  isPillar        Boolean   @default(false)
  order           Int       @default(0) // position telle que listée par la source (plus récent/pertinent d'abord)
  capturedAt      DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@index([source])
}
