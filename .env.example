# En local (dev) : PostgreSQL, ex. via Neon (gratuit) — voir DEPLOY.md
# Format : postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Synchronisation automatique Card D. Kaizoku (voir DEPLOY.md) ---
# Secret partagé qui protège /api/cron/sync-kaizoku — génère une chaîne
# aléatoire d'au moins 16 caractères, la même valeur doit être configurée
# sur Vercel (var d'env CRON_SECRET) ET comme secret GitHub Actions
# (KAIZOKU_CRON_SECRET).
CRON_SECRET="genere-une-longue-chaine-aleatoire-ici"

# deviceId et playerId depuis ton URL Kaizoku personnelle, ex. :
# https://www.cardkaizoku.com/matchhistory/search?deviceId=XXX&playerId=YYY
KAIZOKU_DEVICE_ID="ton-device-id"
KAIZOKU_PLAYER_ID="ton-player-id"
